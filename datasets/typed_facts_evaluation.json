      "source_evidence": [
        {
          "source_id": "drive-1VJ2SzyWQ_xLpzOX-SR09GB7_oAI1GYr0",
          "sha256": "60ccb6065b32d959457faf9745023d763c9f6641ad7c9c8cdee7a88fea454139",
          "page": 222,
          "report_year": 2016,
          "observation_period": null,
          "quote": "Для получения икры в 2016 г. использовались производители маточного стада\n       осётра, выращенные на Гусиноозёрском осетровом рыбоводном хозяйстве (ГОРХ) ФГБУ\n      «Байкалрыбвод». Молодь осётра подращивалась в бассейнах ИЦА-2, установленных в цехе\n1.4  подращивания молоди Селенгинского экспериментального рыбоводного завода, а также в      бассейнах и лотках ГОРХ.",
          "quote_basis": "exact_cached_page_text",
          "source_authenticity": "mirror_unverified",
          "novelty": "already_quoted_fragment",
          "publication_year": null
        },
        {
          "source_id": "drive-1VJ2SzyWQ_xLpzOX-SR09GB7_oAI1GYr0",
          "sha256": "60ccb6065b32d959457faf9745023d763c9f6641ad7c9c8cdee7a88fea454139",
          "page": 222,
          "report_year": 2016,
          "observation_period": null,
          "quote": "В результате подращивания получено и выпущено в р. Селенгу\n      1044 тыс. шт. молоди осётра, в т.ч. 1029 тыс. шт. средней навеской 3,0 г в целях выполнения\n      государственного задания (рис. 1.4.6.3).",
          "quote_basis": "exact_cached_page_text",
          "source_authenticity": "mirror_unverified",
          "novelty": "already_quoted_fragment",
          "publication_year": null
        }
